# Copy to .env and fill in. .env is gitignored.
#
# Only system-level settings live here. The six behavior levers (prompts, tool
# description, temperature, max_loops) live in the database as versioned rows --
# never here, never hardcoded. That is what makes rollout and rollback possible.

GEMINI_API_KEY=

# Pinned on purpose. The "-latest" aliases drift when Google repoints them, and a
# silent model change would show up as "my prompt edit caused a behavior change",
# which is the single hardest kind of regression to diagnose.
#
# Run `uv run python -m ask_luma.cli models` to see what your key can reach.
MODEL=gemini/gemini-3.1-flash-lite

# Path to the SQLite file. Mounted as a volume in docker-compose.
# DB_PATH=./data/app.db
